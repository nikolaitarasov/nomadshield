# NomadShield — copy to .env.local
# The app runs fully in demo mode without these. Add them to enable real Supabase Auth + Storage.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional for local demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — required for live payments (Checkout Sessions and/or Payment Links)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: existing Stripe Price IDs (otherwise we send price_data for $49 / $19 / $190)
STRIPE_PRICE_KIT=
STRIPE_PRICE_SHIELD_MONTH=
STRIPE_PRICE_SHIELD_YEAR=
# Optional: reusable Payment Links from the Stripe Dashboard (https://buy.stripe.com/...)
NEXT_PUBLIC_STRIPE_LINK_KIT=
NEXT_PUBLIC_STRIPE_LINK_SHIELD_MONTH=
NEXT_PUBLIC_STRIPE_LINK_SHIELD_YEAR=

# GoatCounter analytics (privacy-friendly). Site code is the subdomain you create at goatcounter.com
# Example: nomadshield → https://nomadshield.goatcounter.com
NEXT_PUBLIC_GOATCOUNTER_SITE=nomadshield
